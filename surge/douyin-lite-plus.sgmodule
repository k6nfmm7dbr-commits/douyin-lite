#!name=抖音瘦身 · Douyin Lite Plus
#!desc=基础版全部规则 + 信息流广告接口拦截（Map Local 返回空 JSON）。需要 MITM 与信任证书。
#!author=Minis
#!icon=https://raw.githubusercontent.com/k6nfmm7dbr-commits/douyin-lite/main/icon.png
#!category=去广告
#!tag=去广告,抖音,内存
#!homepage=https://github.com/k6nfmm7dbr-commits/douyin-lite
#!openUrl=https://apps.apple.com/cn/app/id1142110895
#!date=2026-10-06
# ------------------------------------------------------------
# ⚠️ 本版需要 MITM + 安装并信任 CA 证书。
#    证书没装好时，改写规则不会生效（也不会报错），域名拦截部分照常工作。
#
# 为什么必须拦接口而不是拦域名：
#   抖音信息流广告的视频素材和正常视频共用同一个 CDN
#   （douyinvod.com / douyinpic.com），域名层面完全没法区分。
#   唯一的区分点是请求路径 /api/ad/ —— 只有 MITM 才能看到路径。
#
# 验证 MITM 是否生效：
#   工具 → MITM → 确认 aweme.snssdk.com 在 hostname 列表里
#   证书信任：iOS 设置 → 通用 → VPN与设备管理
#             以及 设置 → 通用 → 关于本机 → 证书信任设置
#
# 不想装证书 —— 用 douyin-lite.sgmodule（基础版）。
# ------------------------------------------------------------

[Rule]

# ── 穿山甲 / Pangle 广告 SDK ──
DOMAIN-SUFFIX,pangle.cn,REJECT
DOMAIN-SUFFIX,pangle.io,REJECT
DOMAIN-KEYWORD,pangolin,REJECT
DOMAIN-KEYWORD,pglstatp-toutiao,REJECT

# ── 巨量引擎（字节广告投放平台）──
DOMAIN-SUFFIX,oceanengine.com,REJECT
DOMAIN-SUFFIX,oceanengine.cn,REJECT

# ── 广告投放 / 购物广告 / 试玩广告 ──
DOMAIN-SUFFIX,ad.toutiao.com,REJECT
DOMAIN-SUFFIX,adshare.toutiao.com,REJECT
DOMAIN-SUFFIX,shoppingads.cn,REJECT
DOMAIN-KEYWORD,panplayable-toutiao,REJECT
DOMAIN-REGEX,^.*ads.*-normal\.zijieapi\.com$,REJECT

# ── 埋点 / 日志上报（对内存帮助很小，介意可注释掉）──
DOMAIN,extlog.snssdk.com,REJECT
DOMAIN,mcs.snssdk.com,REJECT
DOMAIN,sdfp.snssdk.com,REJECT
DOMAIN-SUFFIX,bds.snssdk.com,REJECT
DOMAIN-SUFFIX,ctobsnssdk.com,REJECT
DOMAIN-SUFFIX,volceapplog.com,REJECT


# ── 信息流广告接口 → 直接返回空 JSON ──
# 抖音拉广告走 /api/ad/，返回 {} 后 App 拿到的就是「这次没有广告」，
# 于是整条广告视频不会下载、不会解码 —— 这是抖音这边最实在的内存收益点。
#
# 用返回 {} 而不是直接 reject：reject 会断开连接，App 可能当成网络
# 错误去重试，反而多出请求。给个合法空响应最干净。
[Map Local]
^https://(aweme\.snssdk\.com|api[0-9]*-normal-[a-z0-9-]+\.amemv\.com)/api/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https://zlink\.ugsdk\.cn/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"


# ── MITM ──
# ⚠️ 这里解密的是抖音的**主 API 域**，是整个项目风险面最大的一段：
#    如果抖音启用了证书固定（cert pinning），MITM 会让这些域直接连不上，
#    表现为抖音打不开 / 一直转圈。真遇到就删掉这一段，回到基础版
#    （基础版的域名拦截已经能拿到大部分收益）。
#
# 只解密承载广告接口的这几个域，不碰视频 CDN、直播、支付相关域。
[MITM]
hostname = %APPEND% aweme.snssdk.com, api*-normal-*.amemv.com, zlink.ugsdk.cn
